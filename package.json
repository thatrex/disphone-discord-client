{
	"name": "disphone-discord-client",
	"version": "1.0.0",
	"author": "thatrex",
	"license": "Apache-2.0",
	"description": "An unofficial Discord browser client developed for Disphone.",
	"keywords": [
		"discord",
		"browser",
		"client",
		"disphone"
	],
	"type": "module",
	"main": "build/index.js",
	"scripts": {
		"dev": "node --loader ts-node/esm src/index.ts",
		"watch": "nodemon --exec pnpm run dev --watch src --ext ts",
		"build": "tsc",
		"start": "node build/index.js"
	},
	"dependencies": {
		"discord-api-types": "^0.38.41",
		"eventemitter3": "^5.0.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.3.5",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.1",
		"ts-node": "^10.9.2",
		"typescript": "5.9.3"
	}
}
