		"lint": "prettier --check . && eslint ."
	},
	"type": "module",
	"main": "build/index.js",
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"@snazzah/davey": "^0.1.10",
		"@snazzah/davey-wasm32-wasi": "^0.1.10",
