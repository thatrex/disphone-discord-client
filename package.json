{
	"name": "disphone-discord-client",
	"version": "1.0.0",
	"author": "thatrex",
	"license": "Apache-2.0",
	"description": "An unofficial Discord browser client developed for Disphone.",
	"keywords": [
		"disphone",
		"discord",
		"browser",
		"client"
	],
	"scripts": {
		"dev": "vite --host",
		"test": "vitest",
