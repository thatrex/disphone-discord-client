{
	"compilerOptions": {
		"target": "ES6",
		"module": "ESNext",
		"outDir": "build",
		"lib": ["DOM", "ESNext"],
		"types": ["vite/client"],
		"strict": true,
		"moduleResolution": "Bundler",
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"ts-node": {
		"transpileOnly": true,
		"experimentalSpecifierResolution": "node"
	},
	"include": ["src/**/*.ts", "testing/**/*.svelte", "testing/**/*.ts"]
}
